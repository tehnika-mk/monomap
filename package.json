{
	"name": "mind-map",
	"private": true,
	"version": "1.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"clean": "node scripts/clean.mjs",
		"build": "npm run clean && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"test:e2e": "playwright test",
		"og:image": "node scripts/og-image.mjs",
		"supabase:login": "npx --yes supabase@2.117.0 login",
		"deploy:functions": "node scripts/supabase.mjs functions deploy --use-api",
		"deploy:db": "node scripts/supabase.mjs db push",
		"deploy:supabase": "npm run deploy:db && npm run deploy:functions"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@supabase/supabase-js": "^2.112.3",
		"html-to-image": "^1.11.13",
		"idb-keyval": "^6.3.0"
	}
}
